# Upstream API base URL. Paths and query strings from client requests are appended.
TARGET_URL=http://localhost:20128

# Upstream credential. Injected on every proxied request, replacing any key the
# client sent. Leave unset to forward the client's own auth headers instead.
# ANTHROPIC_API_KEY works as a fallback name for the same value.
UPSTREAM_API_KEY=

# Header carrying UPSTREAM_API_KEY. Defaults to Anthropic's x-api-key.
# For a Bearer gateway use `authorization` and prefix the value with `Bearer `.
UPSTREAM_AUTH_HEADER=x-api-key

# Server bind address.
LISTEN_ADDR=0.0.0.0:8080

# Maximum buffered request or JSON response body.
GATEKEEPER_MAX_BODY_BYTES=10485760

# tracing-subscriber filter, for example gatekeeper=debug,tower_http=info.
RUST_LOG=info
